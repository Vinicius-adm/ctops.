{
  "name": "ctops-backend",
  "version": "0.1.0",
  "description": "Control Tower OPS - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "test": "tsx scripts/test_host_validation.ts",
    "integration-test": "node scripts/integration_containers_test.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "ctops",
    "observability",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/arm-appcontainers": "^3.0.0",
    "@azure/arm-containerinstance": "^9.1.0",
    "@azure/identity": "^4.13.0",
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
  "seed": "tsx prisma/seed.ts"
}
}
